	SET_GCODE_VARIABLE MACRO=_PLR_VARS VARIABLE=last_save_time VALUE=0.0
	SAVE_VARIABLE VARIABLE=plr_active VALUE=0
	SAVE_VARIABLE VARIABLE=plr_pos VALUE=0
	RESPOND TYPE=echo MSG="PLR: 準備完了 (レイヤー切り替え時に SAVE_PRINT_PROGRESS を実行)"

[gcode_macro PLR_CLEAR]
description = PLRデータをクリア (PRINT_END/CANCEL_PRINTから呼ぶ)
gcode = 
	SET_GCODE_VARIABLE MACRO=_PLR_VARS VARIABLE=last_save_time VALUE=0.0
	SAVE_VARIABLE VARIABLE=plr_active VALUE=0
	SAVE_VARIABLE VARIABLE=plr_pos VALUE=0
	UPDATE_DELAYED_GCODE ID=_PLR_AUTOSAVE DURATION=0

[gcode_macro PLR_STATUS]
description = PLRデータを表示
gcode = 
	{% set s = printer.save_variables.variables %}
	{% if s.plr_active is defined and s.plr_active == 1 %}
	RESPOND TYPE=echo MSG="PLR STATUS: Z={s.plr_z}mm / pos={s.plr_pos} / Bed={s.plr_bed}°C / Ext={s.plr_ext}°C / File={s.plr_file}"
	{% else %}
	RESPOND TYPE=echo MSG="PLR STATUS: 保存データなし（plr_active=0）"
	{% endif %}

[gcode_macro _PLR_HOME_STATE]
description = PLRホーミング制御フラグ
variable_skip_z_home = False
variable_skip_xy_home = False
variable_skip_xy_park = False
gcode = 

[gcode_macro PLR_RESUME]
description = 電源断・エラー後に自動でGコードを分割して印刷を再開する
gcode = 
	{% set s = printer.save_variables.variables %}
	{% if s.plr_active is defined and s.plr_active == 1
	and s.plr_pos is defined and s.plr_pos > 0 %}
	RESPOND TYPE=echo MSG="⚡ PLR: 復旧開始 file={s.plr_file} Z={s.plr_z}mm pos={s.plr_pos}"
	M117 PLR: Gコード生成中...
	RUN_SHELL_COMMAND CMD=plr_split
	RESPOND TYPE=echo MSG="✅ PLR: PLR_resume.gcode 生成完了。3秒後に印刷開始..."
	M117 PLR: 印刷開始準備中...
	UPDATE_DELAYED_GCODE ID=_PLR_START_PRINT DURATION=3
	{% else %}
	RESPOND TYPE=error MSG="PLR: 復旧データがありません (plr_active=0 or plr_pos=0)"
	{% endif %}

[delayed_gcode _PLR_START_PRINT]
initial_duration = 0
gcode = 
	RESPOND TYPE=echo MSG="▶️ PLR: PLR_resume.gcode の印刷を開始します"
	SDCARD_PRINT_FILE FILENAME=PLR_resume.gcode

[gcode_macro SAVE_PRINT_PROGRESS]
description = レイヤー切り替え時に現在の印刷進捗を保存
gcode = 
	_PLR_SAVE

