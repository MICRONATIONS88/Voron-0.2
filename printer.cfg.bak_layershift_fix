	SAVE_VARIABLE VARIABLE=plr_file VALUE='"{filename}"'
	{% endif %}
	
	
	SAVE_VARIABLE VARIABLE=plr_pos VALUE={pos}
	SAVE_VARIABLE VARIABLE=plr_z VALUE={z}
	{% endif %}
	{% endif %}

[delayed_gcode _PLR_AUTOSAVE]
initial_duration = 0
gcode = 
	{% set state = printer.print_stats.state %}
	{% if state == "printing" %}
	_PLR_SAVE
	{% endif %}
	{% if state in ["printing", "paused"] %}
	UPDATE_DELAYED_GCODE ID=_PLR_AUTOSAVE DURATION=60
	{% endif %}

[delayed_gcode _PLR_BOOT_CHECK]
initial_duration = 8
gcode = 
	{% set s = printer.save_variables.variables %}
	{% if s.plr_active is defined and s.plr_active == 1 and s.plr_pos is defined and s.plr_pos > 0 %}
	M117 PLR: 電源断復旧可能!
	RESPOND TYPE=echo MSG="⚡ PLR: 印刷復旧データあり。PLR_RESUME を実行してください (ファイル: {s.plr_file}, Z: {s.plr_z}mm)"
	{% endif %}

[gcode_macro PLR_START]
description = PLR自動保存を開始 (PRINT_STARTから呼ぶ)
