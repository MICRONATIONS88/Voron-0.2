[include timelapse.cfg]
[include mainsail.cfg]

# ===========================================================
# MCU & Printer Settings
# ===========================================================

[mcu]
serial: /dev/serial/by-id/usb-Klipper_rp2040_45503571290BFEF8-if00
restart_method: command

[mcu EBBCan]
# U2C経由のCAN接続用UUID
canbus_uuid: 5d095814ee1b

[printer]
kinematics: corexy
max_velocity: 300
max_accel: 7000
max_z_velocity: 15
max_z_accel: 45
minimum_cruise_ratio: 0.500
square_corner_velocity: 5.0

# ===========================================================
# X/Y Stepper Settings (Sensorless Homing)
# ===========================================================

[stepper_x]
step_pin: gpio11
dir_pin: !gpio10
enable_pin: !gpio12
microsteps: 32
rotation_distance: 40
endstop_pin: tmc2209_stepper_x:virtual_endstop
position_endstop: 120
position_max: 120
homing_speed: 20
homing_retract_dist: 0

[tmc2209 stepper_x]
uart_pin: gpio9
tx_pin: gpio8
uart_address: 0
run_current: 0.6
diag_pin: ^gpio4
driver_SGTHRS: 50
stealthchop_threshold: 0

[stepper_y]
step_pin: gpio6
dir_pin: !gpio5
enable_pin: !gpio7
microsteps: 32
rotation_distance: 40
endstop_pin: tmc2209_stepper_y:virtual_endstop
position_endstop: 120
position_max: 120
homing_speed: 20
homing_retract_dist: 0

[tmc2209 stepper_y]
uart_pin: gpio9
tx_pin: gpio8
uart_address: 2
run_current: 0.6
diag_pin: ^gpio3
driver_SGTHRS: 55
stealthchop_threshold: 0
# ===========================================================
# Z Stepper Settings
# ===========================================================

[stepper_z]
step_pin: gpio19
dir_pin: !gpio28
enable_pin: !gpio2
microsteps: 32
rotation_distance: 8
endstop_pin: ^gpio25
#position_endstop: 120
position_max: 120
homing_speed: 20

[tmc2209 stepper_z]
uart_pin: gpio9
tx_pin: gpio8
uart_address: 1
run_current: 0.6
stealthchop_threshold: 0

# ===========================================================
# Extruder (EBB36) - 元の設定値を反映
# ===========================================================

[extruder]
step_pin: EBBCan: PD0
dir_pin: EBBCan: PD1
enable_pin: !EBBCan: PD2
rotation_distance: 22.23 
gear_ratio: 50:10 
microsteps: 32
nozzle_diameter: 0.400
filament_diameter: 1.750
heater_pin: EBBCan: PB13
sensor_type: ATC Semitec 104NT-4-R025H42G
sensor_pin: EBBCan: PA3
control: pid
pid_Kp: 26.689
pid_Ki: 2.766
pid_Kd: 64.385
min_temp: 0
max_temp: 270

[tmc2209 extruder]
uart_pin: EBBCan: PA15
run_current: 0.6
stealthchop_threshold: 0

# ===========================================================
# Fans & Bed
# ===========================================================

[fan] # Part Cooling Fan (EBB36)
pin: EBBCan: PA1

[heater_fan hotend_fan] # Hotend Fan (EBB36)
pin: EBBCan: PA0
heater: extruder
heater_temp: 50.0

[heater_bed]
heater_pin: gpio21        # 'pin:' から 'heater_pin:' に修正
sensor_type: NTC 100K MGB18-104F39050L32
sensor_pin: gpio26
control: pid
pid_Kp: 63.153
pid_Ki: 2.506
pid_Kd: 397.864
min_temp: 0
max_temp: 110

# ===========================================================
# LED Control (Neopixel)
# ===========================================================

[neopixel board_neopixel]
pin: gpio24
chain_count: 20
color_order: GRB
initial_RED: 0.1
initial_GREEN: 0.1
initial_BLUE: 0.1

# ===========================================================
# ADXL345 (加速度センサー) & Input Shaper
# ===========================================================

[adxl345]
cs_pin: EBBCan: PB12
spi_software_sclk_pin: EBBCan: PB10
spi_software_mosi_pin: EBBCan: PB11
spi_software_miso_pin: EBBCan: PB2
axes_map: x,y,z

[resonance_tester]
accel_chip: adxl345
probe_points:
    60, 60, 20  # Voron 0.2のベッド中央付近でテストを実行

# ===========================================================
# 運用マクロ (前回の設定を完全移植)
# ===========================================================

[gcode_macro PRINT_START]
gcode:
    {% set BED_TEMP = params.BED_TEMP|default(60)|float %}
    {% set EXTRUDER_TEMP = params.EXTRUDER_TEMP|default(200)|float %}
    M117 Heating...
    M140 S{BED_TEMP}
    M104 S150 ; 予熱
    G28
    M190 S{BED_TEMP}
    M109 S{EXTRUDER_TEMP}
    _PURGE_LINE
    CLEAR_PRINT_PROGRESS
    M117 Printing...

[gcode_macro PRINT_END]
gcode:
    M400
    G92 E0
    G1 E-2 F300
    G91
    G1 Z5 F3000
    G90
    G1 X110 Y110 F5000
    M104 S0
    M140 S0
    M106 S0
    M84
    CLEAR_PRINT_PROGRESS
    M117 Finished

[gcode_macro _PURGE_LINE]
gcode:
    G90
    G1 X5 Y4 Z0.2 F3000
    G1 X5 Y50 E10 F1000
    G92 E0

[gcode_macro CLEAN_NOZZLE]
gcode:
    G90
    G1 X10 Y4 Z5 F5000
    {% for i in range(5) %}
        G1 X50 F5000
        G1 X10 F5000
    {% endfor %}

[temperature_sensor EBB36_temp]
sensor_type: temperature_mcu
sensor_mcu: EBBCan

[temperature_sensor SKR_Pico_temp]
sensor_type: temperature_mcu

[bed_screws]
# Voron 0.2の120x120ベッドを想定した位置
screw1: 60, 5
screw1_name: front screw
screw2: 5, 115
screw2_name: back left
screw3: 115, 115
screw3_name: back right

[gcode_macro BED_LEVEL_ASSIST]
description: 手動ベッドレベリングを補助するために各ネジ位置へ移動します
gcode:
    G28 ; ホーミング[cite: 2]
    BED_SCREWS_ADJUST ; レベリングモード開始

[gcode_macro G32]
# Voronの標準的な準備マクロ
gcode:
    G28[cite: 2]
    # 必要に応じて、ここでノズルクリーニングなどを追加

[exclude_object]

[gcode_macro PRESSURE_ADVANCE_TEST]
gcode:
  SET_VELOCITY_LIMIT SQUARE_CORNER_VELOCITY=1 ACCEL=500
  TUNING_TOWER COMMAND=SET_PRESSURE_ADVANCE PARAMETER=ADVANCE START=0 FACTOR=.005

[input_shaper]
#shaper_type_x: mzv
#shaper_freq_x: 75.6
#shaper_type_y: mzv
#shaper_freq_y: 80.4

[gcode_arcs]
resolution: 0.1


# ===========================================================
# 変数保存（印刷再開機能用）
# ===========================================================

[save_variables]
filename: ~/printer_data/config/variables.cfg

# ===========================================================
# 印刷再開マクロ
# ===========================================================

[gcode_macro SAVE_PRINT_PROGRESS]
description: 現在の印刷進捗を保存（スライサーのLayer Change GCodeに追加して使用）
gcode:
    {% set z = printer.toolhead.position.z|float %}
    {% set bed_temp = printer.heater_bed.target|float %}
    {% set extruder_temp = printer.extruder.target|float %}
    SAVE_VARIABLE VARIABLE=resume_z VALUE={z}
    SAVE_VARIABLE VARIABLE=resume_bed_temp VALUE={bed_temp}
    SAVE_VARIABLE VARIABLE=resume_extruder_temp VALUE={extruder_temp}
    SAVE_VARIABLE VARIABLE=resume_valid VALUE=1
    RESPOND MSG="Progress saved: Z={z}mm Bed={bed_temp}C Ext={extruder_temp}C"

[gcode_macro RESUME_PRINT]
description: エラー・電源喪失後に保存された位置から印刷を再開する
gcode:
    {% set svv = printer.save_variables.variables %}
    {% if svv.resume_valid|default(0)|int == 0 %}
        RESPOND TYPE=error MSG="No saved progress found. Run SAVE_PRINT_PROGRESS during a print first."
    {% else %}
        {% set z = svv.resume_z|float %}
        {% set bed_temp = svv.resume_bed_temp|default(60)|float %}
        {% set extruder_temp = svv.resume_extruder_temp|default(200)|float %}
        RESPOND MSG="Resuming print: Z={z}mm Bed={bed_temp}C Ext={extruder_temp}C"
        M117 Resuming at Z={z}mm...
        ; --- Step 1: 加熱開始 ---
        M140 S{bed_temp}
        M104 S150
        ; --- Step 2: ホーミング ---
        G28
        ; --- Step 3: 温度待機 ---
        M190 S{bed_temp}
        M109 S{extruder_temp}
        ; --- Step 4: 再開位置の上へ移動 ---
        G90
        G1 X60 Y60 F6000
        G1 Z{z + 5.0} F1500
        ; --- Step 5: 少量パージ ---
        G92 E0
        G1 E5 F200
        G92 E0
        ; --- Step 6: 保存されたZ位置へ ---
        G1 Z{z} F600
        RESPOND MSG="At resume position Z={z}mm. Start your print from the saved layer."
        M117 Ready! Resume from saved layer.
    {% endif %}

[gcode_macro CLEAR_PRINT_PROGRESS]
description: 保存された印刷進捗をクリアする
gcode:
    SAVE_VARIABLE VARIABLE=resume_valid VALUE=0
    SAVE_VARIABLE VARIABLE=resume_z VALUE=0
    RESPOND MSG="Saved print progress cleared."


# ===========================================================
# Siboor V0 Display (USB接続 STM32F042)
# 設定手順:
#   1. ディスプレイをUSBケーブルでRaspberry Piに接続
#   2. ls /dev/serial/by-id/ を実行してシリアルIDを確認
#   3. 下記の serial: の値を実際のIDに変更
#   4. コメント(#)を全て外してKlipperを再起動
#
# ファームウェアが未適用の場合:
#   ディスプレイのBOOTボタンを押しながらUSB接続し、DFUモードで
#   sudo dfu-util -a 0 -D ~/printer_data/config/v0display_klipper.bin
# ===========================================================

## ↓↓↓ ディスプレイUSB接続後、シリアルIDを確認してコメントを外す ↓↓↓
## シリアルID確認コマンド: ls /dev/serial/by-id/
#[mcu display]
#serial: /dev/serial/by-id/usb-Klipper_stm32f042x6_XXXXXXXXXXXXXXXXXX-if00
#restart_method: command
#
#[display]
#lcd_type: sh1106
#i2c_mcu: display
#i2c_bus: i2c1a
#encoder_pins: ^display:PA4, ^display:PA3
#click_pin: ^!display:PA1
#kill_pin: ^!display:PA5
#x_offset: 2
#
#[neopixel displayStatus]
#pin: display:PA0
#chain_count: 1
#color_order: GRB
#initial_RED: 0.24
#initial_GREEN: 0.02
#initial_BLUE: 0.25
## ↑↑↑ ここまでコメントアウト ↑↑↑
